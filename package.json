{
  "name": "texture-toolset",
  "version": "1.0.0",
  "description": "100% Offline Texture ToolSet - Channel Packer, Normal Map Converter, Height Generator & Seamless Checker",
  "main": "main.js",
  "author": "Texture ToolSet Team <contact@texturetoolset.app>",
  "homepage": "https://github.com/texturetoolset/texture-toolset",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.texturetoolset.app",
    "productName": "Texture ToolSet",
    "files": [
      "index.html",
      "assets/**/*",
      "main.js"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Texture ToolSet Team <contact@texturetoolset.app>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
